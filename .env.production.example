# Production configuration template. Copy to .env on the server (or to
# .env.production for a local production-mode test with .\serve.ps1) and fill in.
# NEVER commit the filled-in file.

# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

DEBUG=0

# Your real domain(s). For a local production-mode test use: localhost,127.0.0.1
ALLOWED_HOSTS=venturearabia.qa,www.venturearabia.qa
CSRF_TRUSTED_ORIGINS=https://venturearabia.qa,https://www.venturearabia.qa

# Unguessable admin path, must end with a slash
ADMIN_URL=va-office-7k2p/

# PostgreSQL
DATABASE_URL=postgres://venture:CHANGE-ME@127.0.0.1:5432/venture

# Email (SMTP) - required so order confirmations and password resets are delivered
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=venture@venture.com.qa
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Venture Arabia <venture@venture.com.qa>
ORDER_NOTIFICATION_EMAIL=venture@venture.com.qa

# 1 when Nginx (or another proxy) terminates HTTPS in front of the app
BEHIND_PROXY=1
# 1 = Django redirects HTTP to HTTPS itself. Set 0 if the proxy already does it, or for a local HTTP test.
FORCE_HTTPS=1
# 1 = Django serves /media/ itself (Windows or no-Nginx setups). 0 when Nginx serves /media/.
SERVE_MEDIA=0
