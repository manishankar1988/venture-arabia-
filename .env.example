# Copy this file to .env and edit the values. NEVER commit .env to version control.

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# 1 for local development only. MUST be 0 in production.
DEBUG=1

# Comma separated. e.g. venturearabia.qa,www.venturearabia.qa
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma separated, with scheme. e.g. https://venturearabia.qa,https://www.venturearabia.qa
CSRF_TRUSTED_ORIGINS=

# Admin panel path (keep it non-obvious in production). Must end with a slash.
ADMIN_URL=manage/

# Database. PostgreSQL is used in development and production.
# Local server (started with .\pg-local.ps1 start):
DATABASE_URL=postgres://venture:venture@127.0.0.1:5432/venture
# Leave DATABASE_URL empty to fall back to SQLite (db.sqlite3) for quick experiments.

# Email (order confirmations, contact form). Leave EMAIL_HOST empty to print emails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Venture Arabia <venture@venture.com.qa>
ORDER_NOTIFICATION_EMAIL=venture@venture.com.qa

# Set to 1 when the site is served over HTTPS behind a proxy such as Nginx.
BEHIND_PROXY=0
