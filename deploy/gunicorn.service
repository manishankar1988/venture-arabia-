# systemd unit for a plain Ubuntu server (no Docker).
# Install:  sudo cp deploy/gunicorn.service /etc/systemd/system/venture.service
#           sudo systemctl daemon-reload && sudo systemctl enable --now venture
# Logs:     journalctl -u venture -f
[Unit]
Description=Venture Arabia website (Gunicorn)
After=network.target postgresql.service

[Service]
User=venture
Group=www-data
WorkingDirectory=/srv/venture
EnvironmentFile=/srv/venture/.env
ExecStart=/srv/venture/.venv/bin/gunicorn venture.wsgi:application \
    --bind 127.0.0.1:8000 --workers 3 --timeout 60 \
    --access-logfile /srv/venture/logs/access.log --error-logfile /srv/venture/logs/error.log
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
